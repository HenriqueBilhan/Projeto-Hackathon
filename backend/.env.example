# ===================== Conecta — Backend =====================
# Copie para .env e ajuste. NUNCA versione o arquivo .env.
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
# Origens permitidas (CORS), separadas por vírgula. Vazio = mesma origem apenas.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# Servir o frontend (../frontend) pelo próprio backend em http://localhost:3000
SERVE_FRONTEND=true
FRONTEND_PATH=../frontend

# ---------- MySQL 8 ----------
# Conta administrativa usada SOMENTE pelo comando "npm run db:setup" (cria o banco e o usuário abaixo).
DB_ROOT_USER=root
DB_ROOT_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=conecta
DB_PASSWORD=troque-esta-senha
DB_NAME=conecta
DB_LOGGING=false
DB_POOL_SIZE=10

# ---------- Autenticação ----------
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=troque-por-um-segredo-com-pelo-menos-32-caracteres
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=7
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=300
# Em produção (HTTPS) mantenha true
COOKIE_SECURE=false
# Somente desenvolvimento: devolve o token de redefinição de senha na resposta (não há envio de e-mail configurado)
EXPOSE_RESET_TOKEN=true

# ---------- Administrador inicial (criado pelo seed) ----------
ADMIN_CPF=
ADMIN_PASSWORD=
ADMIN_NAME=Gestor da rede
ADMIN_EMAIL=

# ---------- API de Dados Abertos do Ministério da Saúde ----------
MS_API_BASE_URL=https://apidadosabertos.saude.gov.br
MS_API_TIMEOUT_MS=30000
MS_API_MAX_RETRIES=4
# Intervalo mínimo entre requisições (respeito aos limites da API pública)
MS_API_MIN_INTERVAL_MS=300
MS_API_MAX_PAGES=2000

# ---------- Sincronização ----------
SYNC_AUTO_ENABLED=false
# Cron (padrão: todo dia às 03:00)
SYNC_CRON=0 3 * * *
# Escopo territorial: siglas de UF (ex.: RS) e/ou municípios IBGE de 6 dígitos (ex.: Novo Hamburgo=431340)
SYNC_UFS=RS
SYNC_MUNICIPIOS=431340,431870
# Competência dos profissionais CNES (AAAAMM). Vazio = detecta a mais recente disponível
SYNC_CNES_COMPETENCIA=
SYNC_INCREMENTAL_MAX_DAYS=31
SYNC_BATCH_SIZE=500
SYNC_LOCK_TIMEOUT_MINUTES=120

# ---------- Auditoria (LGPD) ----------
AUDIT_RETENTION_DAYS=1825
